# Kopier til .env (og .dev.vars for `pnpm start` / wrangler)
# Aktiverer isolert demo uten backend: "Åpne eierdemo" på /eier
SHOWCASE_MODE=true
HUMBITES_MODE=live
# BED base URL, without /v1. Set SHOWCASE_MODE=false to use this backend.
BED_API_URL=http://127.0.0.1:3000
# Lokal origin (vinext dev = 5173)
SITE_URL=http://localhost:5173
# Offentlig Mapbox-token (pk.). Tom = kart/adressesøk av
MAPBOX_PUBLIC_TOKEN=pk.eksempel-offentlig-token
# Server-side Mapbox-token (Matrix/Directions). Hold hemmelig
MAPBOX_ACCESS_TOKEN=sk.eksempel-server-token
MAPBOX_PERMANENT_GEOCODING=false
